[Unit]
Description=Import stable user-supplied evidence files and sync private references
After=arc-interface.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/loci-workstation
EnvironmentFile=%h/.config/loci/arc-evidence-token
EnvironmentFile=%h/.config/loci/evidence-worker.env
ExecStart=%h/src/loci-workstation/.venv/bin/python %h/src/loci-workstation/evidence_worker.py --stable-seconds 300 --threshold-mib 500
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/Downloads/evidence %h/.ssh
ReadWritePaths=%h/.local/share/loci-evidence %h/.local/state/loci-evidence
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
