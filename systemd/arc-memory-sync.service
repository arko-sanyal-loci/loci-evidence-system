[Unit]
Description=Encrypt and version the Arc memory store in its private Git repository
After=arc-interface.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/loci-workstation
ExecStart=/usr/bin/python3 %h/src/loci-workstation/memory_store_sync.py --ssh-key %h/.ssh/arc-memory-deploy
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.ssh/arc-memory-deploy %h/.ssh/known_hosts %h/.config/loci/arc-memory.agekey %h/.config/loci/arc-memory-recipient %h/src/arko-sanyal-loci/arc-canonical/data/arc.db %h/.local/state/loci-session/context-journal.jsonl
ReadWritePaths=%h/src/arko-sanyal-loci/arc-private-memory
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
